# ─── Banana Bot Configuration ───────────────────────────────
# Copy this file to ".env" and fill in your own values.
# Never commit your real .env file to version control.

# Required: your bot's token from https://discord.com/developers/applications
BOT_TOKEN=bot_token_here

# Command prefix for prefix (text) commands. Default: b!
PREFIX=b!

# Your Discord user ID (used for owner-only utilities / error DMs)
OWNER_ID=owner_id_here

# Shown in the /about command
DEVELOPER=bluenotthecolor
WEBSITE=https://www.lannna.ca
SUPPORT_SERVER=https://discord.gg/ucTZH4qEgT
BOT_VERSION=1.0.0

# Path to the SQLite database file
DATABASE_PATH=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Whether to sync slash commands to a single guild for instant testing.
# Leave empty to sync globally (can take up to 1 hour to propagate).
DEV_GUILD_ID=
